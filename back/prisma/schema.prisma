generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  mensagensDevolucao MensagemDevolucao[]
  notificacoes       Notificacao[]
  id                  String               @id @default(cuid())
  nome                String
  email               String               @unique
  senhaHash           String?
  cpfCnpj             String?              @unique
  telefone            String?
  tipo                TipoUsuario          @default(CLIENTE)
  ativo               Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atualizadoEm        DateTime             @updatedAt
  ultimoAcessoEm      DateTime?
  googleId            String?              @unique
  carrinho            Carrinho?
  enderecos           Endereco[]
  favoritos           Favorito[]
  pedidos             Pedido[]
  sessoesRefreshToken SessaoRefreshToken[]
}

model Endereco {
  id           String   @id @default(cuid())
  usuarioId    String
  destinatario String
  cep          String
  rua          String
  numero       String
  complemento  String?
  bairro       String
  cidade       String
  estado       String
  principal    Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([usuarioId, principal])
}

model Categoria {
  id           String              @id @default(cuid())
  nome         String
  slug         String              @unique
  descricao    String?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt
  ativo        Boolean             @default(true)
  imagens      ImagemCategoria[]
  produtos     Produto[]
  promocoes    PromocaoCategoria[]
}

model ImagemCategoria {
  id               String    @id @default(cuid())
  categoriaId      String
  url              String
  textoAlternativo String?
  criadoEm         DateTime  @default(now())
  posicao          Int       @default(0)
  categoria        Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
}

model Produto {
  id            String            @id @default(cuid())
  categoriaId   String
  nome          String
  slug          String            @unique
  descricao     String
  preco         Decimal           @db.Decimal(10, 2)
  estoque       Int               @default(0)
  ativo         Boolean           @default(true)
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt
  favoritos     Favorito[]
  imagens       ImagemProduto[]
  itensCarrinho ItemCarrinho[]
  itensPedido   ItemPedido[]
  categoria     Categoria         @relation(fields: [categoriaId], references: [id])
  materiais     ProdutoMaterial[]
  promocoes     PromocaoProduto[]

  @@index([categoriaId])
  @@index([ativo])
}

model Material {
  id       Int               @id @default(autoincrement())
  nome     String            @unique
  produtos ProdutoMaterial[]
}

model ProdutoMaterial {
  produtoId  String
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([produtoId, materialId])
  @@index([materialId])
}

model ImagemProduto {
  id               String   @id @default(cuid())
  produtoId        String
  url              String
  textoAlternativo String?
  posicao          Int      @default(0)
  criadoEm         DateTime @default(now())
  produto          Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
}

model Carrinho {
  id           String         @id @default(cuid())
  usuarioId    String         @unique
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens        ItemCarrinho[]
}

model ItemCarrinho {
  id           String   @id @default(cuid())
  carrinhoId   String
  produtoId    String
  quantidade   Int      @default(1)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  carrinho     Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([carrinhoId, produtoId])
  @@index([produtoId])
}

model Pedido {
  subtotalProdutos   Decimal?     @db.Decimal(10, 2)
  freteValor         Decimal?     @db.Decimal(10, 2)
  freteCusto         Decimal?     @db.Decimal(10, 2)
  freteServicoId     String?
  freteServico       String?
  freteTransportadora String?
  fretePrazoDias     Int?
  freteOrigemCep     String?
  freteCotadoEm      DateTime?
  freteAmbiente      String?
  entregueEm         DateTime?
  devolucao          Devolucao?
  id                 String       @id @default(cuid())
  usuarioId          String
  status             StatusPedido @default(PENDENTE)
  valorTotal         Decimal      @db.Decimal(10, 2)
  destinatario       String
  cepEntrega         String
  ruaEntrega         String
  numeroEntrega      String
  complementoEntrega String?
  bairroEntrega      String
  cidadeEntrega      String
  estadoEntrega      String
  criadoEm           DateTime     @default(now())
  atualizadoEm       DateTime     @updatedAt
  expiraEm           DateTime?
  itens              ItemPedido[]
  pagamentos         Pagamento[]
  usuario            Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([status])
  @@index([criadoEm])
  @@index([expiraEm])
}

model ItemPedido {
  id               String   @id @default(cuid())
  pedidoId         String
  produtoId        String
  nomeProduto      String
  quantidade       Int
  precoUnitario    Decimal  @db.Decimal(10, 2)
  descontoUnitario Decimal? @db.Decimal(10, 2)
  precoOriginal    Decimal? @db.Decimal(10, 2)
  pedido           Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto          Produto  @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
}

model SessaoRefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model Favorito {
  usuarioId String
  produtoId String
  criadoEm  DateTime @default(now())
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, produtoId])
  @@index([produtoId])
}

model Pagamento {
  id                  String            @id @default(cuid())
  pedidoId            String
  provedor            ProvedorPagamento @default(MERCADO_PAGO)
  metodo              MetodoPagamento
  status              StatusPagamento   @default(PENDENTE)
  valor               Decimal           @db.Decimal(10, 2)
  provedorPagamentoId String?           @unique
  provedorOrdemId     String?           @unique
  referenciaExterna   String            @unique
  chaveIdempotencia   String            @unique
  detalhes            Json?
  criadoEm            DateTime          @default(now())
  atualizadoEm        DateTime          @updatedAt
  pedido              Pedido            @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@index([status])
}

model Promocao {
  id           String              @id @default(cuid())
  nome         String
  descricao    String?
  tipo         TipoDesconto
  valor        Decimal             @db.Decimal(10, 2)
  ativo        Boolean             @default(true)
  inicioEm     DateTime
  fimEm        DateTime
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt
  categorias   PromocaoCategoria[]
  produtos     PromocaoProduto[]

  @@index([ativo, inicioEm, fimEm])
}

model PromocaoProduto {
  promocaoId String
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  promocao   Promocao @relation(fields: [promocaoId], references: [id], onDelete: Cascade)

  @@id([promocaoId, produtoId])
  @@index([produtoId])
}

model PromocaoCategoria {
  promocaoId  String
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  promocao    Promocao  @relation(fields: [promocaoId], references: [id], onDelete: Cascade)

  @@id([promocaoId, categoriaId])
  @@index([categoriaId])
}

enum TipoUsuario {
  CLIENTE
  ADMIN
}

enum StatusPedido {
  PENDENTE
  PAGO
  EM_PREPARACAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  PROCESSANDO
  APROVADO
  RECUSADO
  CANCELADO
  REEMBOLSADO
  EXPIRADO
}

enum MetodoPagamento {
  PIX
  CREDITO
  DEBITO
  BOLETO
}

enum ProvedorPagamento {
  MERCADO_PAGO
}

enum TipoDesconto {
  PERCENTUAL
  FIXO
}

model Postagem {
  blocos       Json     @default("[]")
  estilo       String   @default("CLASSICO")
  id           String   @id @default(cuid())
  titulo       String
  resumo       String
  conteudo     String
  imagemUrl    String   @default("")
  publicada    Boolean  @default(false)
  publicadoEm  DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([publicada, publicadoEm])
}

model Devolucao {
  mensagens    MensagemDevolucao[]
  tipoMotivo   String          @default("OUTRO")
  fotos        FotoDevolucao[]
  id           String          @id @default(cuid())
  pedidoId     String          @unique
  motivo       String
  itens        Json
  status       StatusDevolucao  @default(SOLICITADA)
  resposta     String?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  pedido       Pedido          @relation(fields: [pedidoId], references: [id])

  @@index([status, criadoEm])
}

enum StatusDevolucao {
  SOLICITADA
  APROVADA
  RECUSADA
  RECEBIDA
  CONCLUIDA
}

model FotoDevolucao {
  id          String    @id @default(cuid())
  devolucaoId String
  tipo        String
  dados       Bytes
  devolucao   Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)

  @@index([devolucaoId])
}

model MensagemDevolucao {
  id           String      @id @default(cuid())
  devolucaoId  String
  autorId      String?
  autorTipo    TipoUsuario
  texto        String
  chaveCliente String?     @unique
  criadoEm     DateTime    @default(now())
  devolucao    Devolucao   @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  autor        Usuario?    @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([devolucaoId, criadoEm, id])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  chave     String   @unique
  titulo    String
  texto     String
  url       String
  lidaEm    DateTime?
  criadoEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lidaEm, criadoEm])
}
